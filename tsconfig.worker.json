// Worker-side typecheck. Server code runs in the Worker runtime (no DOM),
// uses hono/jsx. Client files are typechecked by tsconfig.client.json.
{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"lib": ["ESNext"],
		"types": ["vite/client"],
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"paths": {
			"@/*": ["./src/*"]
		},
		"noEmit": true
	},
	"include": [
		"src/index.tsx",
		"src/renderer.tsx",
		"src/db/schema.ts",
		"src/lib/api.ts",
		"src/lib/api-types.ts",
		"src/lib/db.ts",
		"src/lib/light-poll.ts",
		"src/lib/snapshot.ts",
		"src/lib/snapshot.selftest.ts",
		"src/lib/upstream.ts",
		"src/lib/utils.ts",
		"vite.config.ts",
		"worker-configuration.d.ts"
	]
}
