{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		"includes": ["**", "!!**/node_modules", "!!**/dist", "!!**/.wrangler", "!worker-configuration.d.ts"],
		"ignoreUnknown": false
	},
	"formatter": {
		"enabled": true,
		"indentWidth": 4,
		"lineWidth": 120,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noNonNullAssertion": "off"
			},
			"a11y": {
				"noSvgWithoutTitle": "off"
			},
			"nursery": {
				"useSortedClasses": {
					"fix": "safe",
					"level": "warn",
					"options": {
						"functions": ["clsx", "cva", "tw", "tw.*"]
					}
				}
			}
		},
		"domains": {
			"tailwind": "recommended",
			"react": "recommended"
		},
		"includes": [
			"**",
			"!!**/src/components/ui/**/*.tsx",
			"!!**/src/components/dither-kit/**/*.tsx",
			"!!**/src/routeTree.gen.ts"
		]
	},
	"javascript": {
		"formatter": {
			"semicolons": "always",
			"quoteStyle": "double",
			"trailingCommas": "all"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							[":BUN:", ":NODE:"],
							":BLANK_LINE:",
							[":PACKAGE:", "!@*/**"],
							":BLANK_LINE:",
							":PACKAGE:",
							":BLANK_LINE:",
							"@/components/ui/**/*",
							":BLANK_LINE:",
							"@/components/**/*",
							":BLANK_LINE:",
							":ALIAS:",
							":PATH:"
						]
					}
				}
			}
		}
	}
}
