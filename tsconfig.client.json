{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "node"],
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"paths": {
			"@/*": ["./src/*"]
		},
		"noEmit": true
	},
	"include": [
		"src/client.tsx",
		"src/routes",
		"src/components/ui",
		"src/components/dither-kit",
		"src/lib/queries.ts",
		"src/lib/api-types.ts",
		"src/lib/utils.ts",
		"scripts/assets.tsx"
	]
}
