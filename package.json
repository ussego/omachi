{
	"name": "omastats",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "bun run assets && vite build",
		"preview": "bun run build && vite preview",
		"deploy": "bun run build && wrangler deploy",
		"lint": "biome lint",
		"format": "biome format --write",
		"typecheck": "bun x tsc -p tsconfig.worker.json --noEmit && bun x tsc -p tsconfig.client.json --noEmit",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply omastats --local",
		"db:migrate:remote": "wrangler d1 migrations apply omastats --remote",
		"assets": "bun scripts/assets.tsx"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@daypicker/react": "^10.0.1",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource/geist-pixel": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-router": "^1.170.32",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cnfast": "^0.1.0",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"drizzle-orm": "^1.0.0-rc.4",
		"hono": "^4.13.5",
		"lucide-react": "^1.34.0",
		"motion": "^13.1.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@cloudflare/vite-plugin": "^1.44.0",
		"@cloudflare/workers-types": "^5.20260827.1",
		"@tanstack/router-plugin": "^1.168.35",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.2.0",
		"@types/node": "^26.4.0",
		"@types/pngjs": "^6.0.5",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"drizzle-kit": "^1.0.0-rc.4",
		"pngjs": "^7.0.0",
		"takumi-js": "^2.12.0",
		"typescript": "^7.0.2",
		"vite": "^8.1.4",
		"vite-ssr-components": "^0.6.1",
		"wrangler": "^4.126.0"
	}
}